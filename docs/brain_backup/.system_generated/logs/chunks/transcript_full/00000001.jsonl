pace=12, acceleration=12, agility=12,\n                        jumping_reach=11, heading=11, strength=12,\n                        tackling=13, marking=13, positioning=12,\n                        composure=9, first_touch=10, decisions=10, passing=10\n                    ),\n                ),\n            ],\n        ),\n    ),\n}\n\n\nclass LiveMatchSimulator:\n    def __init__(self) -> None:\n        self._current_scenario_id: str = \"high_line_tired_fb\"\n        self._state: MatchSnapshot = copy.deepcopy(SCENARIOS[self._current_scenario_id])\n\n    def get_snapshot(self) -> MatchSnapshot:\n        return copy.deepcopy(self._state)\n\n    def load_scenario(self, scenario_id: str) -> MatchSnapshot:\n        if scenario_id in SCENARIOS:\n            self._current_scenario_id = scenario_id\n            self._state = copy.deepcopy(SCENARIOS[scenario_id])\n        return self.get_snapshot()\n\n    def apply_override(\n        self,\n        match_minute: int | None = None,\n        opp_defensive_line: int | None = None,\n        opp_defensive_width: int | None = None,\n        opp_dl_condition: float | None = None,\n        opp_dl_booked: bool | None = None,\n    ) -> MatchSnapshot:\n        if match_minute is not None:\n            self._state.match_minute = max(1, min(120, match_minute))\n        if opp_defensive_line is not None:\n            self._state.opponent_team.defensive_line = max(1, min(5, opp_defensive_line))\n        if opp_defensive_width is not None:\n            self._state.opponent_team.defensive_width = max(1, min(5, opp_defensive_width))\n\n        for p in self._state.opponent_team.players:\n            if p.slot in (\"DL\", \"WBL\"):\n                if opp_dl_condition is not None:\n                    p.condition = max(10.0, min(100.0, opp_dl_condition))\n                if opp_dl_booked is not None:\n                    p.is_booked = opp_dl_booked\n        return self.get_snapshot()\n","Overwrite":true,"Path":"c:\\GProjects\\FM_REA_HeadCoach\\backend\\app\\memory\\simulator.py"}}]}
{"step_index":30,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T07:24:04Z","content":"Created At: 2026-10-29T16:24:04+09:00\nCompleted At: 2026-10-29T16:24:06+09:00\nCreated file."}
{"step_index":31,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T07:24:06Z","input_tokens":4822,"cache_read_tokens":36807,"output_tokens":1242,"thinking":"Developing a `reader.py` module is required to interact with the game process. This module's primary function will be attaching via a memory library to the `fm.exe` process. The module will be responsible for resolving pointers within the game's memory space and providing a fallback mechanism to a simulated match environment in the absence of a running game process.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nPymem Real-Time Memory Reader for Football Manager (fm.exe)\nAttaches to fm.exe in read-only mode, resolves pointer chains / AOB signatures from offsets.json,\nand automatically falls back to LiveMatchSimulator when fm.exe is not running.\n\"\"\"\nfrom __future__ import annotations\nimport json\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\n\nfrom app.memory.simulator import LiveMatchSimulator\nfrom app.models.match_state import MatchSnapshot\n\ntry:\n    import pymem\n    import pymem.process\n    PYMEM_AVAILABLE = True\nexcept ImportError:\n    PYMEM_AVAILABLE = False\n\n\nclass FMMemoryReader:\n    def __init__(self, simulator: LiveMatchSimulator) -> None:\n        self.simulator = simulator\n        self.offsets_path = Path(__file__).parent / \"offsets.json\"\n        self.config: Dict[str, Any] = self._load_offsets()\n        self.pm: Optional[Any] = None\n        self.module_base: Optional[int] = None\n        self.is_attached: bool = False\n\n    def _load_offsets(self) -> Dict[str, Any]:\n        if self.offsets_path.exists():\n            return json.loads(self.offsets_path.read_text(encoding=\"utf-8\"))\n        return {\"target_process\": \"fm.exe\", \"pointer_chains\": {}, \"player_struct_offsets\": {}}\n\n    def try_attach(self) -> bool:\n        \"\"\"Attempt to attach to fm.exe using Pymem.\"\"\"\n        if not PYMEM_AVAILABLE:\n            self.is_attached = False\n            return False\n        target = self.config.get(\"target_process\", \"fm.exe\")\n        try:\n            self.pm = pymem.Pymem(target)\n            module = pymem.process.module_from_name(self.pm.process_handle, target)\n            self.module_base = module.lpBaseOfDll\n            self.is_attached = True\n            return True\n        except Exception:\n            self.pm = None\n            self.module_base = None\n            self.is_attached = False\n            return False\n\n    def resolve_pointer_chain(self, base_offset_hex: str, offsets_hex: List[str]) -> Optional[int]:\n        \"\"\"Follows a multi-level pointer chain starting from module_base + base_offset.\"\"\"\n        if not self.is_attached or self.pm is None or self.module_base is None:\n            return None\n        try:\n            addr = self.module_base + int(base_offset_hex, 16)\n            for off_str in offsets_hex[:-1]:\n                addr = self.pm.read_longlong(addr)\n                if not addr:\n                    return None\n                addr += int(off_str, 16)\n            final_ptr = self.pm.read_longlong(addr)\n            if not final_ptr:\n                return None\n            return final_ptr + int(offsets_hex[-1], 16)\n        except Exception:\n            return None\n\n    @staticmethod\n    def normalize_attr(raw_val: int) -> float:\n        \"\"\"Converts FM internal 1~100 attribute scale (if > 20) to standard 1~20 scale.\"\"\"\n        if raw_val > 20:\n            return round(max(1.0, min(20.0, raw_val / 5.0)), 1)\n        return float(max(1, min(20, raw_val)))\n\n    def read_snapshot(self) -> MatchSnapshot:\n        \"\"\"\n        Attempts to read live match state from fm.exe memory.\n        If fm.exe is not running or match controller pointer is null (e.g. on main menu),\n        returns the current snapshot from LiveMatchSimulator.\n        \"\"\"\n        if not self.is_attached:\n            self.try_attach()\n\n        if self.is_attached and self.pm is not None:\n            chains = self.config.get(\"pointer_chains\", {})\n            clock_chain = chains.get(\"match_clock_minute\")\n            if clock_chain:\n                clock_addr = self.resolve_pointer_chain(\n                    clock_chain[\"base_offset\"], clock_chain[\"offsets\"]\n                )\n                if clock_addr:\n                    try:\n                        live_min = self.pm.read_int(clock_addr)\n                        if 0 <= live_min <= 130:\n                            snap = self.simulator.get_snapshot()\n                            snap.match_minute = live_min\n                            snap.data_source = \"PYMEM_LIVE\"\n                            return snap\n                    except Exception:\n                        self.is_attached = False\n\n        return self.simulator.get_snapshot()\n","Overwrite":true,"Path":"c:\\GProjects\\FM_REA_HeadCoach\\backend\\app\\memory\\reader.py"}}]}
{"step_index":32,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T07:24:30Z","content":"Created At: 2026-10-29T16:24:30+09:00\nCompleted At: 2026-10-29T16:24:33+09:00\nCreated file."}
{"step_index":33,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T07:24:33Z","input_tokens":3371,"cache_read_tokens":39580,"output_tokens":1337,"thinking":"Initial focus is on constructing the `main.py` entry point. This file will orchestrate several core modules: data retrieval from memory, calculation of effective statistics, spatial analysis, matchup matrix generation, and the application of tactical rules. The goal is to establish a central control point that integrates these components.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nFM_REA_HeadCoach FastAPI Server & Real-Time WebSocket Engine\nRuns the 4-stage tactical analysis pipeline on every tick and streams results to the dashboard.\n\"\"\"\nfrom __future__ import annotations\nimport asyncio\nfrom pathlib import Path\nfrom typing import Optional\nfrom fastapi import FastAPI, WebSocket, WebSocketDisconnect\nfrom fastapi.middleware.cors import CORSMiddleware\nfrom fastapi.responses import FileResponse\nfrom fastapi.staticfiles import StaticFiles\nfrom pydantic import BaseModel\n\nfrom app.engine.effective_stats import apply_effective_stats_to_team\nfrom app.engine.matchup_matrix import compute_matchup_matrix\nfrom app.engine.rule_engine import TacticalRuleEngine\nfrom app.engine.spatial_analyzer import analyze_spatial_vulnerability\nfrom app.memory.reader import FMMemoryReader\nfrom app.memory.simulator import LiveMatchSimulator\nfrom app.models.match_state import FullAnalysisResponse, MatchSnapshot\n\napp = FastAPI(\n    title=\"FM_REA_HeadCoach API\",\n    description=\"Football Manager Real-Time Tactical Vulnerability & Matchup Bleed-Point Engine\",\n    version=\"1.0.0\",\n)\n\napp.add_middleware(\n    CORSMiddleware,\n    allow_origins=[\"*\"],\n    allow_credentials=True,\n    allow_methods=[\"*\"],\n    allow_headers=[\"*\"],\n)\n\nsimulator = LiveMatchSimulator()\nmemory_reader = FMMemoryReader(simulator=simulator)\nrule_engine = TacticalRuleEngine()\n\n\ndef run_full_analysis(snapshot: MatchSnapshot) -> FullAnalysisResponse:\n    \"\"\"Executes the 4 core mathematical modules on a MatchSnapshot.\"\"\"\n    # Module 1: Effective Stats (Stamina Decay & Yellow Card Penalty)\n    apply_effective_stats_to_team(snapshot.my_team)\n    apply_effective_stats_to_team(snapshot.opponent_team)\n\n    # Module 2: Spatial Vulnerability Analysis (6 Pitch Zones)\n    zones = analyze_spatial_vulnerability(snapshot.my_team, snapshot.opponent_team)\n    primary_zone = max(zones, key=lambda z: z.svs_score)\n\n    # Module 3: 1v1 Matchup Bleed-Point Matrix\n    matchups, bleed_alerts = compute_matchup_matrix(snapshot.my_team, snapshot.opponent_team)\n\n    # Module 4: Rule-Based Tactical Instruction Generator\n    recommendations = rule_engine.evaluate_rules(snapshot, zones, matchups)\n\n    return FullAnalysisResponse(\n        snapshot=snapshot,\n        zones=zones,\n        primary_target_zone=primary_zone,\n        matchups=matchups,\n        bleed_alerts=bleed_alerts,\n        recommendations=recommendations,\n    )\n\n\nclass OverridePayload(BaseModel):\n    match_minute: Optional[int] = None\n    opp_defensive_line: Optional[int] = None\n    opp_defensive_width: Optional[int] = None\n    opp_dl_condition: Optional[float] = None\n    opp_dl_booked: Optional[bool] = None\n\n\n@app.get(\"/api/analysis\", response_model=FullAnalysisResponse)\ndef get_current_analysis() -> FullAnalysisResponse:\n    snap = memory_reader.read_snapshot()\n    return run_full_analysis(snap)\n\n\n@app.post(\"/api/scenario/{scenario_id}\", response_model=FullAnalysisResponse)\ndef switch_scenario(scenario_id: str) -> FullAnalysisResponse:\n    snap = simulator.load_scenario(scenario_id)\n    return run_full_analysis(snap)\n\n\n@app.post(\"/api/override\", response_model=FullAnalysisResponse)\ndef override_parameters(payload: OverridePayload) -> FullAnalysisResponse:\n    snap = simulator.apply_override(\n        match_minute=payload.match_minute,\n        opp_defensive_line=payload.opp_defensive_line,\n        opp_defensive_width=payload.opp_defensive_width,\n        opp_dl_condition=payload.opp_dl_condition,\n        opp_dl_booked=payload.opp_dl_booked,\n    )\n    return run_full_analysis(snap)\n\n\n@app.websocket(\"/ws/match\")\nasync def match_websocket_endpoint(websocket: WebSocket) -> None:\n    await websocket.accept()\n    try:\n        while True:\n            snap = memory_reader.read_snapshot()\n            analysis = run_full_analysis(snap)\n            await websocket.send_json(analysis.model_dump())\n            await asyncio.sleep(0.8)\n    except WebSocketDisconnect:\n        pass\n\n\nFRONTEND_DIR = Path(__file__).resolve().parents[2] / \"frontend\"\nif FRONTEND_DIR.exists():\n    app.mount(\"/static\", StaticFiles(directory=str(FRONTEND_DIR)), name=\"static\")\n\n\n@app.get(\"/\")\ndef serve_dashboard():\n    index_file = FRONTEND_DIR / \"index.html\"\n    if index_file.exists():\n        return FileResponse(str(index_file))\n    return {\"message\": \"FM_REA_HeadCoach Backend Running. Open /docs for API.\"}\n","Overwrite":true,"Path":"c:\\GProjects\\FM_REA_HeadCoach\\backend\\app\\main.py"}}]}
{"step_index":34,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-29T07:24:48Z","content":"Created At: 2026-10-29T16:24:48+09:00\nCompleted At: 2026-10-29T16:24:49+09:00\nCreated file."}
{"step_index":35,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T07:24:49Z","input_tokens":2658,"cache_read_tokens":41710,"output_tokens":18943,"thinking":"Building the local web dashboard will be the next step. The goal is to create a responsive, informative dashboard for the Football Manager Tactical HeadCoach. It will automatically connect to the FastAPI backend using a WebSocket connection.\n\n\nPlanning the dashboard UI elements. The header bar will display connection status, match time, and score. Three preset scenario buttons will provide quick access to tactical analyses based on common in-game situations.\n\n\nAnalyzing defensive weaknesses and potential build-up pressure traps. A prominent popup banner will highlight the most probable breakthrough opportunity or pressing trap. An interactive tactical pitch heatmap will visualize spatial vulnerabilities across six zones, incorporating live $SVS$ scores, color-coding, and various differentials.\n\n\nAnalyzing real-time player matchup data, specifically focusing on dribbling success probability ($P_{\\text{dribble}}$), to identify potential weaknesses in the opposing team's defense. Defensive line height and width, along with the left back's yellow card status, are crucial factors influencing tactical decisions. The 1v1 matchup bleed matrix highlights individual player advantages and disadvantages across various attributes.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"<!DOCTYPE html>\n<html lang=\"ko\" class=\"dark\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>FM_REA_HeadCoach | 실시간 전술 공략 & 매치업 유혈 지점 대시보드</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@400;500;600;700;800&display=swap');\n    body {\n      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;\n      background-color: #0b0f17;\n      color: #e2e8f0;\n    }\n    .pitch-bg {\n      background: radial-gradient(circle at 50% 30%, #143326 0%, #0d231a 70%, #091912 100%);\n      border: 2px solid rgba(52, 211, 153, 0.28);\n      position: relative;\n    }\n    .zone-card {\n      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n      backdrop-filter: blur(6px);\n    }\n    .zone-card:hover {\n      transform: translateY(-2px);\n    }\n    .pulse-border {\n      animation: pulseGlow 2s infinite;\n    }\n    @keyframes pulseGlow {\n      0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.45); }\n      50% { box-shadow: 0 0 18px 4px rgba(16, 185, 129, 0.25); }\n    }\n    .bleed-pulse {\n      animation: bleedGlow 2s infinite;\n    }\n    @keyframes bleedGlow {\n      0%, 100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.5); }\n      50% { box-shadow: 0 0 20px 3px rgba(244, 63, 94, 0.28); }\n    }\n  </style>\n</head>\n<body class=\"min-h-screen flex flex-col selection:bg-emerald-500 selection:text-slate-950\">\n\n  <!-- Top Navigation & Match Status Header -->\n  <header class=\"border-b border-slate-800/90 bg-slate-950/90 sticky top-0 z-30 backdrop-blur-md\">\n    <div class=\"max-w-[1600px] mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/40 flex items-center justify-center text-emerald-400 font-extrabold text-lg\">\n          FM\n        </div>\n        <div>\n          <div class=\"flex items-center gap-2\">\n            <h1 class=\"font-bold text-lg tracking-tight text-white\">FM_REA_HeadCoach</h1>\n            <span id=\"connBadge\" class=\"text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n              실시간 분석 엔진 가동 중\n            </span>\n          </div>\n          <p class=\"text-xs text-slate-400\">실시간 실효 스탯 감쇠(γ) · 6구역 공간 취약도(SVS) · 1:1 매치업 유혈 지점 · If-Then 전술 추천</p>\n        </div>\n      </div>\n\n      <!-- Scoreboard -->\n      <div class=\"flex items-center gap-4 bg-slate-900/90 border border-slate-800 px-4 py-2 rounded-xl\">\n        <div class=\"text-right\">\n          <div id=\"myTeamName\" class=\"text-xs font-bold text-emerald-400\">FC 서울 헤드코치</div>\n          <div id=\"myFormation\" class=\"text-[11px] text-slate-400\">4-2-3-1 Wide</div>\n        </div>\n        <div class=\"px-3 py-1 rounded-lg bg-slate-950 border border-slate-800 text-center min-w-[90px]\">\n          <div id=\"matchClock\" class=\"text-xs font-bold text-amber-400\">68:00'</div>\n          <div id=\"scoreText\" class=\"text-base font-extrabold text-white tracking-wider\">1 : 1</div>\n        </div>\n        <div class=\"text-left\">\n          <div id=\"oppTeamName\" class=\"text-xs font-bold text-rose-400\">레알 마드리드 B</div>\n          <div id=\"oppFormation\" class=\"text-[11px] text-slate-400\">4-3-3 High Press</div>\n        </div>\n      </div>\n\n      <!-- Scenario Presets -->\n      <div class=\"flex items-center gap-2 flex-wrap\">\n        <span class=\"text-xs text-slate-400 font-medium mr-1\">상황 프리셋:</span>\n        <button onclick=\"selectScenario('high_line_tired_fb')\" id=\"btn_scen_1\"\n          class=\"text-xs px-3 py-1.5 rounded-lg font-semibold border transition bg-emerald-500/20 border-emerald-500/50 text-emerald-300\">\n          ① 상대 높은 라인 + 풀백 방전(64%)\n        </button>\n        <button onclick=\"selectScenario('low_block_central_congestion')\" id=\"btn_scen_2\"\n          class=\"text-xs px-3 py-1.5 rounded-lg font-semibold border transition bg-slate-900 border-slate-700 text-slate-300 hover:bg-slate-800\">\n          ② 상대 5-3-2 중앙 밀집 저블록\n        </button>\n        <button onclick=\"selectScenario('aerial_mismatch_press_trap')\" id=\"btn_scen_3\"\n          class=\"text-xs px-3 py-1.5 rounded-lg font-semibold border transition bg-slate-900 border-slate-700 text-slate-300 hover:bg-slate-800\">\n          ③ 상대 단신 수비진 + 빌드업 구멍\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Urgent Bleed-Point Top Alert Banner -->\n  <div class=\"max-w-[1600px] w-full mx-auto px-4 pt-4\">\n    <div id=\"urgentBanner\" class=\"rounded-xl border border-rose-500/50 bg-gradient-to-r from-rose-950/70 via-slate-900/90 to-slate-900/90 px-4 py-3 flex flex-wrap items-center justify-between gap-3 bleed-pulse\">\n      <div class=\"flex items-center gap-3\">\n        <span class=\"px-2.5 py-1 rounded-md bg-rose-500 text-slate-950 font-extrabold text-xs tracking-wide uppercase\">\n          긴급 유혈 지점 (BLEED POINT)\n        </span>\n        <div>\n          <div id=\"urgentTitle\" class=\"text-sm font-bold text-white\">\n            상대 좌측 풀백 M. 구티에레스 체력 64% 저하 (+경고 1장) → 우측 윙어 이강인 돌파 성공 기대 확률 81.2%!\n          </div>\n          <div id=\"urgentSub\" class=\"text-xs text-rose-200/80 mt-0.5\">\n            인게임 실효 능력치 감쇠 계수 γ(64%)=0.91 적용 · 태클/적극성 옐로카드 페널티 -15% 반영됨\n          </div>\n        </div>\n      </div>\n      <div id=\"urgentZoneBadge\" class=\"text-xs font-bold px-3 py-1.5 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-300\">\n        최우선 공략 구역: 수비 라인 뒷공간 (SVS 86.5)\n      </div>\n    </div>\n  </div>\n\n  <!-- Main 3-Column Tactical Grid -->\n  <main class=\"max-w-[1600px] w-full mx-auto px-4 py-4 grid grid-cols-1 lg:grid-cols-12 gap-4 flex-1\">\n\n    <!-- COLUMN 1 (Left, 4 cols): Spatial Analysis Pitch Heatmap & Live Parameter Controller -->\n    <section class=\"lg:col-span-4 flex flex-col gap-4\">\n      <div class=\"rounded-2xl bg-slate-900/80 border border-slate-800 p-4 flex flex-col gap-3\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <h2 class=\"text-sm font-bold text-white flex items-center gap-2\">\n              <span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n              1. 상대 수비 블록 및 공백 분석 (Spatial Analysis)\n            </h2>\n            <p class=\"text-[11px] text-slate-400 mt-0.5\">속도(ΔV)·침투(ΔM)·역동작(ΔA)×전술배율 기반 구역별 취약도(SVS)</p>\n          </div>\n          <span class=\"text-[11px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono\">▲ 공격 방향</span>\n        </div>\n\n        <!-- Tactical Pitch 6-Zone Heatmap -->\n        <div class=\"pitch-bg rounded-xl p-3 flex flex-col gap-2.5 select-none\">\n          <!-- Opponent Goal Line Indicator -->\n          <div class=\"w-1/2 mx-auto h-2 border-t-2 border-x-2 border-emerald-400/30 rounded-t-sm\"></div>\n\n          <!-- Row 1: Space Behind Defensive Line -->\n          <div id=\"zone_behind_line\" class=\"zone-card rounded-xl p-3 border text-center cursor-pointer\">\n            <!-- Populated by JS -->\n          </div>\n\n          <!-- Row 2: Left Flank | Left Half-Space | Right Half-Space | Right Flank -->\n          <div class=\"grid grid-cols-2 gap-2\">\n            <div id=\"zone_left_flank\" class=\"zone-card rounded-xl p-2.5 border\"></div>\n            <div id=\"zone_right_flank\" class=\"zone-card rounded-xl p-2.5 border\"></div>\n          </div>\n\n          <!-- Row 3: Half-Spaces & Central Zone 14 -->\n          <div class=\"grid grid-cols-3 gap-2\">\n            <div id=\"zone_left_halfspace\" class=\"zone-card rounded-xl p-2.5 border\"></div>\n            <div id=\"zone_center_zone14\" class=\"zone-card rounded-xl p-2.5 border\"></div>\n            <div id=\"zone_right_halfspace\" class=\"zone-card rounded-xl p-2.5 border\"></div>\n          </div>\n\n          <!-- Pitch Midfield Line -->\n          <div class=\"border-t border-dashed border-emerald-400/25 mt-1 pt-1.5 flex justify-between text-[10px] text-emerald-300/60 font-mono\">\n            <span>좌측 공격 채널 (AML/DL)</span>\n            <span>중앙 빌드업</span>\n            <span>우측 공격 채널 (AMR/DR)</span>\n          </div>\n        </div>\n\n        <!-- Legend -->\n        <div class=\"grid grid-cols-4 gap-1.5 text-[11px] text-center pt-1\">\n          <div class=\"px-2 py-1 rounded bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 font-semibold\">SVS ≥ 70 핵심공략</div>\n          <div class=\"px-2 py-1 rounded bg-sky-500/20 border border-sky-500/40 text-sky-300 font-semibold\">58~69 우위구역</div>\n          <div class=\"px-2 py-1 rounded bg-slate-800 border border-slate-700 text-slate-300\">42~57 균형</div>\n          <div class=\"px-2 py-1 rounded bg-rose-500/15 border border-rose-500/30 text-rose-300\">≤ 41 밀집/회피</div>\n        </div>\n      </div>\n\n      <!-- Interactive Live Match Memory Override / Simulator Controller -->\n      <div class=\"rounded-2xl bg-slate-900/80 border border-slate-800 p-4 flex flex-col gap-3\">\n        <div class=\"flex items-center justify-between\">\n          <h3 class=\"text-xs font-bold text-amber-400 uppercase tracking-wider\">\n            실시간 경기 변수 시뮬레이터 (스탯 감쇠 & 전술 반응 검증)\n          </h3>\n          <span class=\"text-[11px] text-slate-400\">슬라이더 조작 시 즉시 수식 재계산</span>\n        </div>\n\n        <div class=\"space-y-3 text-xs\">\n          <!-- Slider 1: Opponent DL Stamina -->\n          <div>\n            <div class=\"flex justify-between mb-1\">\n              <span class=\"text-slate-300 font-medium\">상대 좌측 풀백/윙백(DL) 실시간 체력</span>\n              <span id=\"lbl_dl_cond\" class=\"font-bold text-rose-400 font-mono\">64% (γ=0.91)</span>\n            </div>\n            <input id=\"inp_dl_cond\" type=\"range\" min=\"35\" max=\"100\" value=\"64\" oninput=\"onControlChange()\"\n              class=\"w-full accent-emerald-500 cursor-pointer h-1.5 bg-slate-800 rounded-lg\" />\n          </div>\n\n          <!-- Toggle: Opponent DL Yellow Card -->\n          <div class=\"flex items-center justify-between py-1 border-y border-slate-800/80\">\n            <span class=\"text-slate-300 font-medium\">상대 좌측 풀백(DL) 옐로카드 누적 여부 (태클 -15%)</span>\n            <label class=\"inline-flex items-center gap-2 cursor-pointer\">\n              <input id=\"inp_dl_booked\" type=\"checkbox\" checked onchange=\"onControlChange()\"\n                class=\"w-4 h-4 accent-amber-400 rounded cursor-pointer\" />\n              <span class=\"text-amber-300 font-semibold\">경고 1장 보유</span>\n            </label>\n          </div>\n\n          <!-- Slider 2: Opponent Defensive Line -->\n          <div>\n            <div class=\"flex justify-between mb-1\">\n              <span class=\"text-slate-300 font-medium\">상대 감독 수비 라인 높이 (1:매우낮음 ~ 5:매우높음)</span>\n              <span id=\"lbl_def_line\" class=\"font-bold text-emerald-400 font-mono\">5단계 (매우 높음)</span>\n            </div>\n            <input id=\"inp_def_line\" type=\"range\" min=\"1\" max=\"5\" value=\"5\" oninput=\"onControlChange()\"\n              class=\"w-full accent-emerald-500 cursor-pointer h-1.5 bg-slate-800 rounded-lg\" />\n          </div>\n\n          <!-- Slider 3: Opponent Defensive Width -->\n          <div>\n            <div class=\"flex justify-between mb-1\">\n              <span class=\"text-slate-300 font-medium\">상대 수비 폭 (1:극단적 중앙밀집 ~ 5:넓게)</span>\n              <span id=\"lbl_def_width\" class=\"font-bold text-sky-400 font-mono\">2단계 (중앙 밀집)</span>\n            </div>\n            <input id=\"inp_def_width\" type=\"range\" min=\"1\" max=\"5\" value=\"2\" oninput=\"onControlChange()\"\n              class=\"w-full accent-emerald-500 cursor-pointer h-1.5 bg-slate-800 rounded-lg\" />\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- COLUMN 2 (Center, 4 cols): 1v1 Matchup Bleed Matrix -->\n    <section class=\"lg:col-span-4 flex flex-col gap-4\">\n      <div class=\"rounded-2xl bg-slate-900/80 border border-slate-800 p-4 flex flex-col gap-3 h-full\">\n        <div>\n          <h2 class=\"text-sm font-bold text-white flex items-center gap-2\">\n            <span class=\"w-2 h-2 rounded-full bg-rose-400\"></span>\n            2. 매치업 유혈 지점 매핑 (1v1 Matchup Matrix)\n          </h2>\n          <p class=\"text-[11px] text-slate-400 mt-0.5\">실효 스탯 기반 1:1 돌파 성공률(P_dribble) · 제공권(P_aerial) · 압박 턴오버(P_trap)</p>\n        </div>\n\n        <div id=\"matchupList\" class=\"flex flex-col gap-3 overflow-y-auto\">\n          <!-- Populated by JS -->\n        </div>\n      </div>\n    </section>\n\n    <!-- COLUMN 3 (Right, 4 cols): If-Then Tactical Instruction Guideline Feed -->\n    <section class=\"lg:col-span-4 flex flex-col gap-4\">\n      <div class=\"rounded-2xl bg-slate-900/80 border border-slate-800 p-4 flex flex-col gap-3 h-full\">\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <h2 class=\"text-sm font-bold text-white flex items-center gap-2\">\n              <span class=\"w-2 h-2 rounded-full bg-amber-400\"></span>\n              3. 전술 지시 가이드라인 자동 생성 (If-Then Engine)\n            </h2>\n            <p class=\"text-[11px] text-slate-400 mt-0.5\">FM 인게임에서 즉시 클릭해야 할 팀 지시(TI) · 개인 지시(PI) · 상대 대응(OI)</p>\n          </div>\n          <span id=\"recCountBadge\" class=\"text-xs font-bold px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30\">\n            4건 활성\n          </span>\n        </div>\n\n        <div id=\"recommendationList\" class=\"flex flex-col gap-3\">\n          <!-- Populated by JS -->\n        </div>\n\n        <!-- Mathematical Formula Reference Box -->\n        <div class=\"mt-auto pt-3 border-t border-slate-800/90 text-[11px] text-slate-400 space-y-1.5 bg-slate-950/60 p-3 rounded-xl\">\n          <div class=\"font-bold text-slate-300\">작동 중인 매치 엔진 역추적 공식 요약</div>\n          <div>• <span class=\"text-emerald-400 font-semibold\">실효 스탯 보정</span>: S_eff = S_base × γ(Condition) × (1 - 0.15·Booked)</div>\n          <div>• <span class=\"text-sky-400 font-semibold\">공간 취약도(SVS)</span>: clip(50 + 4.5 × (0.45·ΔV + 0.35·ΔM + 0.20·ΔA) × M_tactic)</div>\n          <div>• <span class=\"text-rose-400 font-semibold\">1:1 돌파 확률</span>: σ(0.28 × [(Dri·0.35 + Acc·0.25 + Agi·0.2 + Fla·0.2)_A - (Tck·0.35 + Mar·0.25 + Pos·0.2 + Agi·0.2)_D])</div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <script>\n    // =========================================================================\n    // Built-in Tactical Analysis Engine (mirrors backend/app/engine/* 1:1)\n    // Automatically syncs with FastAPI backend if running on localhost:8000,\n    // or runs directly in-browser for zero-latency interactive testing.\n    // =========================================================================\n\n    function makeAttrs(overrides) {\n      return Object.assign({\n        pace: 13, acceleration: 13, agility: 13, balance: 13,\n        jumping_reach: 12, strength: 12, stamina: 14,\n        dribbling: 12, first_touch: 13, passing: 13, crossing: 12,\n        tackling: 12, marking: 12, heading: 12, flair: 12,\n        off_the_ball: 13, positioning: 12, anticipation: 13,\n        decisions: 13, composure: 13, concentration: 12,\n        aggression: 13, bravery: 13\n      }, overrides);\n    }\n\n    const MY_TEAM_TEMPLATE = {\n      team_name: \"FC 서울 헤드코치 (우리 팀)\",\n      formation: \"4-2-3-1 Wide\",\n      mentality: 4, defensive_line: 4, pressing_intensity: 4, defensive_width: 3,\n      players: [\n        {\n          player_id: 101, name: \"이강인\", shirt_number: 19, slot: \"AMR\",\n          role_name: \"인버티드 윙어 (공격)\", condition: 86.0, is_booked: false,\n          base_attrs: makeAttrs({\n            pace: 15, acceleration: 16, agility: 18, balance: 17,\n            dribbling: 18, flair: 18, first_touch: 17, passing: 17, crossing: 16,\n            off_the_ball: 16, anticipation: 16, decisions: 15, jumping_reach: 8, heading: 8\n          })\n        },\n        {\n          player_id: 102, name: \"손흥민\", shirt_number: 7, slot: \"AML\",\n          role_name: \"인사이드 포워드 (공격)\", condition: 84.0, is_booked: false,\n          base_attrs: makeAttrs({\n            pace: 17, acceleration: 17, agility: 16, balance: 15,\n            dribbling: 16, flair: 16, first_touch: 16, off_the_ball: 18,\n            anticipation: 17, composure: 17, jumping_reach: 12, heading: 12\n          })\n        },\n        {\n          player_id: 103, name: \"오현규\", shirt_number: 9, slot: \"ST_C\",\n          role_name: \"전진형 포워드 (공격)\", condition: 85.0, is_booked: false,\n          base_attrs: makeAttrs({\n            pace: 15, acceleration: 16, agility: 15, balance: 16,\n            jumping_reach: 14, strength: 16, heading: 14, bravery: 16,\n            dribbling: 14, off_the_ball: 16, anticipation: 15\n          })\n        },\n        {\n          player_id: 104, name: \"이재성\", shirt_number: 10, slot: \"AMC\",\n          role_name: \"공격형 미드필더 (지원)\", condition: 82.0, is_booked: false,\n          base_attrs: makeAttrs({\n            pace: 13, acceleration: 14, agility: 15, balance: 15,\n            passing: 15, first_touch: 16, off_the_ball: 17, anticipation: 17,\n            decisions: 16, stamina: 18, tackling: 12\n          })\n        }\n      ]\n    };\n\n    const SCENARIO_PRESETS = {\n      high_line_tired_fb: {\n        match_minute: 68, home_score: 1, away_score: 1,\n        scenario_id: \"high_line_tired_fb\",\n        opponent_team: {\n          team_name: \"레알 마드리드 B\", formation: \"4-3-3 High Press\",\n          mentality: 4, defensive_line: 5, pressing_intensity: 4, defensive_width: 2,\n          players: [\n            {\n              player_id: 201, name: \"M. 구티에레스\", shirt_number: 3, slot: \"DL\",\n              role_name: \"완성형 윙백\", condition: 64.0, is_booked: true,\n              base_attrs: makeAttrs({\n                pace: 14, acceleration: 14, agility: 13, balance: 12,\n                tackling: 11, marking: 10, positioning: 10, concentration: 10,\n                jumping_reach: 10, heading: 9, composure: 13, first_touch: 14\n              })\n            },\n            {\n              player_id: 202, name: \"D. 카르바할\", shirt_number: 2, slot: \"DR\",\n              role_name: \"풀백 (지원)\", condition: 78.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 14, acceleration: 14, agility: 14, 