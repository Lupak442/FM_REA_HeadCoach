ive_width: 1,\n          players: [\n            {\n              player_id: 301, name: \"S. 리노\", shirt_number: 12, slot: \"WBL\",\n              role_name: \"윙백 (지원)\", condition: 61.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 15, acceleration: 15, agility: 14,\n                tackling: 10, marking: 9, positioning: 9, concentration: 9,\n                jumping_reach: 9, heading: 8\n              })\n            },\n            {\n              player_id: 302, name: \"N. 몰리나\", shirt_number: 16, slot: \"WBR\",\n              role_name: \"윙백 (지원)\", condition: 63.0, is_booked: true,\n              base_attrs: makeAttrs({\n                pace: 15, acceleration: 15, agility: 13,\n                tackling: 11, marking: 10, positioning: 10, concentration: 10\n              })\n            },\n            {\n              player_id: 303, name: \"J. 히메네스\", shirt_number: 2, slot: \"DC_C\",\n              role_name: \"중앙 수비수\", condition: 81.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 13, acceleration: 12, agility: 11,\n                jumping_reach: 16, heading: 17, strength: 17,\n                tackling: 16, marking: 16, positioning: 16, concentration: 15\n              })\n            },\n            {\n              player_id: 304, name: \"R. 르노르망\", shirt_number: 24, slot: \"DC_L\",\n              role_name: \"중앙 수비수\", condition: 80.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 13, acceleration: 12, agility: 11,\n                jumping_reach: 16, heading: 16, strength: 16,\n                tackling: 15, marking: 16, positioning: 16\n              })\n            },\n            {\n              player_id: 305, name: \"A. 비첼\", shirt_number: 20, slot: \"DC_R\",\n              role_name: \"리베로\", condition: 69.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 9, acceleration: 9, agility: 10,\n                jumping_reach: 15, heading: 14, strength: 15,\n                tackling: 14, marking: 14, positioning: 16, composure: 16\n              })\n            }\n          ]\n        }\n      },\n      aerial_mismatch_press_trap: {\n        match_minute: 55, home_score: 2, away_score: 1,\n        scenario_id: \"aerial_mismatch_press_trap\",\n        opponent_team: {\n          team_name: \"브라이튼 유스\", formation: \"4-2-3-1 Build-up\",\n          mentality: 4, defensive_line: 4, pressing_intensity: 4, defensive_width: 3,\n          players: [\n            {\n              player_id: 401, name: \"V. 바르코\", shirt_number: 19, slot: \"DL\",\n              role_name: \"인버티드 윙백\", condition: 76.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 14, acceleration: 15, agility: 15,\n                jumping_reach: 7, heading: 7, strength: 8,\n                tackling: 11, marking: 10, positioning: 10\n              })\n            },\n            {\n              player_id: 402, name: \"T. 램프티\", shirt_number: 2, slot: \"DR\",\n              role_name: \"윙백 (공격)\", condition: 74.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 17, acceleration: 18, agility: 16,\n                jumping_reach: 6, heading: 6, strength: 7,\n                tackling: 11, marking: 10, positioning: 9\n              })\n            },\n            {\n              player_id: 403, name: \"I. 마르티네스\", shirt_number: 4, slot: \"DC_L\",\n              role_name: \"공격형 수비수\", condition: 77.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 13, acceleration: 13, agility: 13,\n                jumping_reach: 10, heading: 11, strength: 11,\n                tackling: 13, marking: 13, positioning: 12,\n                composure: 8, first_touch: 9, decisions: 9, passing: 9\n              })\n            },\n            {\n              player_id: 404, name: \"J. 폴 헤케\", shirt_number: 5, slot: \"DC_R\",\n              role_name: \"중앙 수비수\", condition: 79.0, is_booked: false,\n              base_attrs: makeAttrs({\n                pace: 12, acceleration: 12, agility: 12,\n                jumping_reach: 11, heading: 11, strength: 12,\n                tackling: 13, marking: 13, positioning: 12,\n                composure: 9, first_touch: 10, decisions: 10, passing: 10\n              })\n            }\n          ]\n        }\n      }\n    };\n\n    let currentState = JSON.parse(JSON.stringify(SCENARIO_PRESETS.high_line_tired_fb));\n    currentState.my_team = JSON.parse(JSON.stringify(MY_TEAM_TEMPLATE));\n\n    // Module 1: Effective Stats\n    function computeGamma(c) {\n      if (c >= 75) return 1.0;\n      if (c >= 55) return +(1.0 - 0.008 * (75 - c)).toFixed(4);\n      return +Math.max(0.4, 0.84 - 0.015 * (55 - c)).toFixed(4);\n    }\n\n    function applyEffectiveStats(team) {\n      team.players.forEach(p => {\n        const g = computeGamma(p.condition);\n        const tg = 0.5 + 0.5 * g;\n        const card = p.is_booked ? 0.85 : 1.0;\n        const b = p.base_attrs;\n        p.stamina_decay_factor = g;\n        p.effective_attrs = {\n          pace: +(b.pace * g).toFixed(2),\n          acceleration: +(b.acceleration * g).toFixed(2),\n          agility: +(b.agility * g).toFixed(2),\n          balance: +(b.balance * g).toFixed(2),\n          jumping_reach: +(b.jumping_reach * (0.65 + 0.35 * g)).toFixed(2),\n          strength: +(b.strength * (0.6 + 0.4 * g)).toFixed(2),\n          stamina: b.stamina,\n          dribbling: +(b.dribbling * tg).toFixed(2),\n          first_touch: +(b.first_touch * tg).toFixed(2),\n          passing: +(b.passing * tg).toFixed(2),\n          crossing: +(b.crossing * tg).toFixed(2),\n          tackling: +(b.tackling * tg * card).toFixed(2),\n          marking: +(b.marking * tg).toFixed(2),\n          heading: +(b.heading * tg).toFixed(2),\n          flair: b.flair,\n          off_the_ball: +(b.off_the_ball * (0.35 + 0.65 * g)).toFixed(2),\n          positioning: +(b.positioning * (0.4 + 0.6 * g)).toFixed(2),\n          anticipation: +(b.anticipation * tg).toFixed(2),\n          decisions: +(b.decisions * tg).toFixed(2),\n          composure: +(b.composure * tg).toFixed(2),\n          concentration: +(b.concentration * g).toFixed(2),\n          aggression: +(b.aggression * card).toFixed(2),\n          bravery: b.bravery\n        };\n      });\n    }\n\n    function selectPlayers(players, slots, fallback) {\n      let m = players.filter(p => slots.includes(p.slot));\n      if (!m.length) m = players.filter(p => fallback.includes(p.slot));\n      if (!m.length) m = players.slice(-2);\n      return m;\n    }\n\n    function avgEff(players, attr) {\n      if (!players.length) return 12;\n      return players.reduce((acc, p) => acc + p.effective_attrs[attr], 0) / players.length;\n    }\n\n    // Module 2: Spatial Vulnerability Analysis\n    function computeSpatialZones(myTeam, oppTeam) {\n      const myP = myTeam.players;\n      const oppP = oppTeam.players;\n      const oppCbCount = oppP.filter(p => [\"DC_L\", \"DC_C\", \"DC_R\"].includes(p.slot)).length;\n      const oppDmCount = oppP.filter(p => [\"DM_L\", \"DM_C\", \"DM_R\"].includes(p.slot)).length;\n      const hasWideFb = oppP.some(p => [\"DL\", \"DR\"].includes(p.slot));\n\n      const flankMult = +(1.0 + (3 - oppTeam.defensive_width) * 0.12 + (!hasWideFb ? 0.10 : 0)).toFixed(2);\n      const halfMult = +(1.0 + (oppTeam.pressing_intensity - 3) * 0.08).toFixed(2);\n      const centerMult = +(1.0 - ((oppCbCount >= 3 || oppDmCount >= 2) ? 0.12 : 0) + (oppTeam.defensive_width - 3) * 0.10).toFixed(2);\n      const behindMult = +(0.70 + 0.15 * oppTeam.defensive_line).toFixed(2);\n\n      const configs = [\n        {\n          zone_id: \"behind_line\", zone_name_kr: \"수비 라인 뒷공간 (스루패스 침투)\",\n          att: [\"ST_C\", \"AML\", \"AMR\"], attFb: [\"AMC\"],\n          def: [\"DC_L\", \"DC_C\", \"DC_R\", \"DL\", \"DR\"], defFb: [\"DM_C\"],\n          mult: behindMult, bonus: (oppTeam.defensive_line - 3) * 0.65\n        },\n        {\n          zone_id: \"left_flank\", zone_name_kr: \"좌측 측면 (vs 상대 우측 수비)\",\n          att: [\"AML\", \"ML\", \"DL\"], attFb: [\"ST_C\"],\n          def: [\"DR\", \"WBR\"], defFb: [\"DC_R\", \"DC_C\"],\n          mult: flankMult, bonus: !oppP.some(p => p.slot === \"DR\") ? 0.8 : 0\n        },\n        {\n          zone_id: \"right_flank\", zone_name_kr: \"우측 측면 (vs 상대 좌측 수비)\",\n          att: [\"AMR\", \"MR\", \"DR\"], attFb: [\"ST_C\"],\n          def: [\"DL\", \"WBL\"], defFb: [\"DC_L\", \"DC_C\"],\n          mult: flankMult, bonus: !oppP.some(p => p.slot === \"DL\") ? 0.8 : 0\n        },\n        {\n          zone_id: \"left_halfspace\", zone_name_kr: \"좌측 하프스페이스\",\n          att: [\"AML\", \"AMC\"], attFb: [\"ST_C\"],\n          def: [\"DC_R\", \"DR\", \"DM_C\"], defFb: [\"DC_C\"],\n          mult: halfMult, bonus: 0\n        },\n        {\n          zone_id: \"center_zone14\", zone_name_kr: \"중앙 2선 (Zone 14)\",\n          att: [\"AMC\", \"ST_C\"], attFb: [\"AML\", \"AMR\"],\n          def: [\"DM_C\", \"DC_C\", \"DC_L\", \"DC_R\"], defFb: [\"DL\"],\n          mult: centerMult, bonus: (oppCbCount >= 3) ? -1.2 : 0\n        },\n        {\n          zone_id: \"right_halfspace\", zone_name_kr: \"우측 하프스페이스\",\n          att: [\"AMR\", \"AMC\"], attFb: [\"ST_C\"],\n          def: [\"DC_L\", \"DL\", \"DM_C\"], defFb: [\"DC_C\"],\n          mult: halfMult, bonus: 0\n        }\n      ];\n\n      return configs.map(c => {\n        const atts = selectPlayers(myP, c.att, c.attFb);\n        const defs = selectPlayers(oppP, c.def, c.defFb);\n        const dv = +((0.55 * avgEff(atts, \"acceleration\") + 0.45 * avgEff(atts, \"pace\")) -\n                     (0.55 * avgEff(defs, \"acceleration\") + 0.45 * avgEff(defs, \"pace\"))).toFixed(2);\n        const dm = +((0.60 * avgEff(atts, \"off_the_ball\") + 0.40 * avgEff(atts, \"anticipation\")) -\n                     (0.50 * avgEff(defs, \"positioning\") + 0.30 * avgEff(defs, \"concentration\") + 0.20 * avgEff(defs, \"decisions\"))).toFixed(2);\n        const da = +((0.60 * avgEff(atts, \"agility\") + 0.40 * avgEff(atts, \"balance\")) -\n                     (0.65 * avgEff(defs, \"agility\") + 0.35 * avgEff(defs, \"balance\"))).toFixed(2);\n        const zRaw = (0.45 * dv + 0.35 * dm + 0.20 * da + c.bonus) * c.mult;\n        const svs = Math.max(0, Math.min(100, +(50 + 4.5 * zRaw).toFixed(1)));\n        const status = svs >= 70 ? \"CRITICAL_TARGET\" : (svs >= 58 ? \"ADVANTAGE\" : (svs >= 42 ? \"NEUTRAL\" : \"AVOID\"));\n        return {\n          zone_id: c.zone_id, zone_name_kr: c.zone_name_kr,\n          svs_score: svs, velocity_gap: dv, movement_gap: dm, agility_gap: da,\n          tactical_multiplier: c.mult, status_label: status\n        };\n      });\n    }\n\n    function sigmoidPct(x, k) {\n      return +(100 / (1 + Math.exp(-k * x))).toFixed(1);\n    }\n\n    // Module 3: Matchup Matrix\n    function computeMatchups(myTeam, oppTeam) {\n      const pairs = [\n        [\"right_wing_1v1\", \"우측 측면 1:1 매치업\", [\"AMR\"], [\"DL\", \"WBL\", \"DC_L\"]],\n        [\"left_wing_1v1\", \"좌측 측면 1:1 매치업\", [\"AML\"], [\"DR\", \"WBR\", \"DC_R\"]],\n        [\"striker_vs_lcb\", \"중앙 공격수 vs 상대 좌측 센터백\", [\"ST_C\"], [\"DC_L\", \"DC_C\"]],\n        [\"striker_vs_rcb\", \"중앙 공격수 vs 상대 우측 센터백\", [\"ST_C\"], [\"DC_R\", \"DC_C\"]]\n      ];\n\n      return pairs.map(([id, label, attSlots, defSlots]) => {\n        const att = selectPlayers(myTeam.players, attSlots, [\"ST_C\"])[0];\n        const dfn = selectPlayers(oppTeam.players, defSlots, [\"DC_L\"])[0];\n        const a = att.effective_attrs;\n        const d = dfn.effective_attrs;\n\n        const xDri = (0.35 * a.dribbling + 0.25 * a.acceleration + 0.20 * a.agility + 0.20 * a.flair) -\n                     (0.35 * d.tackling + 0.25 * d.marking + 0.20 * d.positioning + 0.20 * d.agility);\n        const pDri = sigmoidPct(xDri, 0.28);\n\n        const xAir = (0.45 * a.jumping_reach + 0.25 * a.heading + 0.20 * a.strength + 0.10 * a.bravery) -\n                     (0.45 * d.jumping_reach + 0.25 * d.heading + 0.20 * d.strength + 0.10 * d.bravery);\n        const pAir = sigmoidPct(xAir, 0.30);\n\n        const xTrap = 13.0 - (0.30 * d.composure + 0.25 * d.first_touch + 0.25 * d.decisions + 0.20 * d.passing);\n        const pTrap = sigmoidPct(xTrap, 0.35);\n\n        const agiDiff = +((0.60 * a.agility + 0.40 * a.balance) - (0.65 * d.agility + 0.35 * d.balance)).toFixed(2);\n        const reasons = [];\n        if (dfn.condition <= 70 && pDri >= 66) {\n          reasons.push(`체력 고갈(${dfn.condition.toFixed(0)}%) → 돌파 기대 확률 ${pDri}%`);\n        } else if (pDri >= 72) {\n          reasons.push(`1:1 온더볼 돌파 절대 우위 (${pDri}%)`);\n        }\n        if (dfn.is_booked && pDri >= 60) {\n          reasons.push(`경고 누적(태클 -15%) → 파울/돌파 취약`);\n        }\n        if (pAir >= 70) {\n          reasons.push(`제공권 미스매치 우위 (${pAir}%)`);\n        }\n        if (pTrap >= 68) {\n          reasons.push(`빌드업 압박 턴오버 타겟 (${pTrap}%)`);\n        }\n\n        return {\n          pair_id: id, zone_label: label,\n          att, dfn,\n          dribble_prob: pDri, aerial_prob: pAir, press_trap_prob: pTrap,\n          agility_diff: agiDiff,\n          is_bleed_point: reasons.length > 0,\n          bleed_reasons: reasons\n        };\n      });\n    }\n\n    // Module 4: Rule Engine\n    function evaluateRules(state, zones, matchups) {\n      const zMap = Object.fromEntries(zones.map(z => [z.zone_id, z]));\n      const opp = state.opponent_team;\n      const recs = [];\n\n      const leftF = zMap.left_flank;\n      const rightF = zMap.right_flank;\n      const centerZ = zMap.center_zone14;\n      const behindZ = zMap.behind_line;\n      const bestFlank = rightF.svs_score >= leftF.svs_score ? rightF : leftF;\n      const flankKr = bestFlank.zone_id === \"right_flank\" ? \"우측 측면\" : \"좌측 측면\";\n\n      const oppCbCount = opp.players.filter(p => [\"DC_L\", \"DC_C\", \"DC_R\"].includes(p.slot)).length;\n      const isCentralCongested = opp.defensive_width <= 2 || oppCbCount >= 3 || centerZ.svs_score <= 46;\n\n      if (isCentralCongested && bestFlank.svs_score >= 62) {\n        recs.push({\n          rule_id: \"R-01\",\n          priority: bestFlank.svs_score >= 72 ? \"URGENT\" : \"HIGH\",\n          category: \"팀 전술 지시 (TI)\",\n          title: `중앙 밀집 블록 우회 → [${flankKr} 집중 공략] 및 패스 길이 조정`,\n          action_badges: [\"패스 길이: 짧게 → 혼합\", \"공격 폭: 넓게\", `${flankKr} 집중 공략`],\n          reasoning: `상대가 중앙 밀집형 수비(수비 폭 ${opp.defensive_width}단계, 중앙 SVS ${centerZ.svs_score})를 사용하므로 패스 길이를 '짧게'에서 '혼합'으로 바꾸고, 공백이 열린 ${flankKr}(SVS ${bestFlank.svs_score}) 공략을 지시하세요.`,\n          trigger_metric: `${flankKr} SVS ${bestFlank.svs_score} vs 중앙 ${centerZ.svs_score}`\n        });\n      }\n\n      if (opp.defensive_line >= 4 && behindZ.svs_score >= 66) {\n        recs.push({\n          rule_id: \"R-02\",\n          priority: \"URGENT\",\n          category: \"팀 전술 지시 (TI)\",\n          title: \"상대 높은 수비라인 뒷공간 노출 → [공간으로 패스하라] 활성화\",\n          action_badges: [\"공간으로 패스하라 (Pass Into Space)\", \"템포: 빠르게\", \"공격수: 라인 침투\"],\n          reasoning: `상대 수비 라인이 높고(${opp.defensive_line}단계/5), 공격진 속도 우위(ΔV ${behindZ.velocity_gap >= 0 ? '+' : ''}${behindZ.velocity_gap}) 및 센터백 역동작 격차(ΔA ${behindZ.agility_gap >= 0 ? '+' : ''}${behindZ.agility_gap})가 큽니다.`,\n          trigger_metric: `뒷공간 SVS ${behindZ.svs_score}`\n        });\n      }\n\n      matchups.filter(m => [\"right_wing_1v1\", \"left_wing_1v1\"].includes(m.pair_id)).forEach(wm => {\n        if ((wm.dfn.condition <= 70 || wm.dfn.is_booked) && wm.dribble_prob >= 65) {\n          const sideKr = wm.pair_id === \"right_wing_1v1\" ? \"우측\" : \"좌측\";\n          recs.push({\n            rule_id: \"R-03\",\n            priority: \"URGENT\",\n            category: \"개인/팀 지시 (PI/TI)\",\n            title: `[${sideKr} 유혈 지점] ${wm.dfn.name}(체력 ${wm.dfn.condition.toFixed(0)}%) 상대로 1:1 집중 돌파`,\n            action_badges: [`${wm.att.name}: 드리블 더 많이`, `${sideKr} 측면 집중 공략`, `${sideKr} 오버래핑/언더래핑`],\n            reasoning: `상대 ${wm.dfn.slot} ${wm.dfn.name}의 체력이 ${wm.dfn.condition.toFixed(0)}%로 떨어져 실효 민첩성·태클이 급락했습니다(${wm.dfn.is_booked ? '옐로카드 페널티 포함' : ''}). ${wm.att.name}의 돌파 성공 확률이 ${wm.dribble_prob}%에 달합니다.`,\n            trigger_metric: `1:1 돌파 기대 확률 ${wm.dribble_prob}%`\n          });\n        }\n      });\n\n      const stMatchups = matchups.filter(m => [\"striker_vs_lcb\", \"striker_vs_rcb\"].includes(m.pair_id));\n      if (stMatchups.length) {\n        const avgAir = stMatchups.reduce((s, m) => s + m.aerial_prob, 0) / stMatchups.length;\n        const avgAgi = stMatchups.reduce((s, m) => s + m.agility_diff, 0) / stMatchups.length;\n        if (avgAir <= 44 && avgAgi >= 1.8) {\n          recs.push({\n            rule_id: \"R-04\",\n            priority: \"HIGH\",\n            category: \"팀 전술 지시 (TI)\",\n            title: \"상대 장신 센터백 점프거리 무력화 → [낮은 크로스] 전환\",\n            action_badges: [\"크로스 유형: 낮은 크로스 (Low Crosses)\", \"페널티 박스 안으로 공을 투입하라\"],\n            reasoning: `상대 센터백 대비 제공권 승률은 ${avgAir.toFixed(1)}%로 열세이나, 발목 반응성/민첩성 우위(ΔA +${avgAgi.toFixed(1)})가 큽니다. 땅볼 낮은 크로스로 상대의 높은 점프거리 스탯을 무력화하세요.`,\n            trigger_metric: `제공권 ${avgAir.toFixed(1)}% | 역동작 우위 +${avgAgi.toFixed(1)}`\n          });\n        } else if (avgAir >= 66) {\n          recs.push({\n            rule_id: \"R-05\",\n            priority: \"HIGH\",\n            category: \"팀 전술 지시 (TI)\",\n            title: \"상대 단신 수비진 제공권 압도 → [높은 크로스] 및 [얼리 크로스]\",\n            action_badges: [\"크로스 유형: 높은 크로스\", \"일찍 크로스를 올려라\"],\n            reasoning: `상대 수비진의 점프거리·몸싸움이 낮아 공중볼 경합 승률이 ${avgAir.toFixed(1)}%로 압도적입니다. 높은 크로스로 폭격하세요.`,\n            trigger_metric: `제공권 승률 ${avgAir.toFixed(1)}%`\n          });\n        }\n      }\n\n      const traps = matchups.filter(m => m.press_trap_prob >= 68);\n      if (traps.length) {\n        const worst = traps.sort((a, b) => b.press_trap_prob - a.press_trap_prob)[0];\n        recs.push({\n          rule_id: \"R-06\",\n          priority: \"HIGH\",\n          category: \"상대 대응 지시 (OI)\",\n          title: `[빌드업 압박 트랩] ${worst.dfn.name} 집중 압박 및 약발 유도`,\n          action_badges: [`${worst.dfn.name}: 항상 압박 (Trigger Press)`, \"태클: 강하게\", \"약발로 유도\"],\n          reasoning: `상대 ${worst.dfn.name}(${worst.dfn.slot})의 침착성(${worst.dfn.base_attrs.composure})과 퍼스트터치(${worst.dfn.base_attrs.first_touch})가 낮아 압박 시 턴오버 유발 확률이 ${worst.press_trap_prob}%입니다.`,\n          trigger_metric: `턴오버 유발 확률 ${worst.press_trap_prob}%`\n        });\n      }\n\n      return recs;\n    }\n\n    function zoneStyle(status) {\n      if (status === \"CRITICAL_TARGET\") {\n        return {\n          box: \"bg-emerald-500/20 border-emerald-400/70 text-emerald-100 pulse-border\",\n          badge: \"bg-emerald-400 text-slate-950 font-extrabold\",\n          tag: \"핵심 공략\"\n        };\n      }\n      if (status === \"ADVANTAGE\") {\n        return {\n          box: \"bg-sky-500/20 border-sky-400/50 text-sky-100\",\n          badge: \"bg-sky-400 text-slate-950 font-bold\",\n          tag: \"공략 유리\"\n        };\n      }\n      if (status === \"NEUTRAL\") {\n        return {\n          box: \"bg-slate-900/75 border-slate-700/80 text-slate-200\",\n          badge: \"bg-slate-700 text-slate-200 font-semibold\",\n          tag: \"균형\"\n        };\n      }\n      return {\n        box: \"bg-rose-950/45 border-rose-500/40 text-rose-200/80\",\n        badge: \"bg-rose-500/30 text-rose-200 font-semibold\",\n        tag: \"밀집/우회\"\n      };\n    }\n\n    function renderDashboard() {\n      applyEffectiveStats(currentState.my_team);\n      applyEffectiveStats(currentState.opponent_team);\n\n      const zones = computeSpatialZones(currentState.my_team, currentState.opponent_team);\n      const matchups = computeMatchups(currentState.my_team, currentState.opponent_team);\n      const recs = evaluateRules(currentState, zones, matchups);\n\n      // Header Info\n      document.getElementById(\"oppTeamName\").textContent = currentState.opponent_team.team_name;\n      document.getElementById(\"oppFormation\").textContent = currentState.opponent_team.formation;\n      document.getElementById(\"matchClock\").textContent = `${currentState.match_minute}:00'`;\n      document.getElementById(\"scoreText\").textContent = `${currentState.home_score} : ${currentState.away_score}`;\n\n      // Urgent Top Banner\n      const bestZone = [...zones].sort((a, b) => b.svs_score - a.svs_score)[0];\n      const topMatchup = [...matchups].sort((a, b) => Math.max(b.dribble_prob, b.aerial_prob) - Math.max(a.dribble_prob, a.aerial_prob))[0];\n\n      document.getElementById(\"urgentTitle\").textContent =\n        `[${topMatchup.zone_label}] 상대 ${topMatchup.dfn.name} (체력 ${topMatchup.dfn.condition.toFixed(0)}%${topMatchup.dfn.is_booked ? '·경고1' : ''}) → ${topMatchup.att.name} 돌파 기대치 ${topMatchup.dribble_prob}% / 제공권 ${topMatchup.aerial_prob}%`;\n      document.getElementById(\"urgentSub\").textContent =\n        `실효 스탯 감쇠 계수 γ=${topMatchup.dfn.stamina_decay_factor} 적용됨 (표기 주력 ${topMatchup.dfn.base_attrs.pace} → 실효 ${topMatchup.dfn.effective_attrs.pace}, 표기 민첩 ${topMatchup.dfn.base_attrs.agility} → 실효 ${topMatchup.dfn.effective_attrs.agility})`;\n      document.getElementById(\"urgentZoneBadge\").textContent =\n        `최우선 공략 구역: ${bestZone.zone_name_kr.split('(')[0].trim()} (SVS ${bestZone.svs_score})`;\n\n      // Render 6 Pitch Zones\n      zones.forEach(z => {\n        const el = document.getElementById(`zone_${z.zone_id}`);\n        if (!el) return;\n        const st = zoneStyle(z.status_label);\n        el.className = `zone-card rounded-xl p-2.5 border ${st.box}`;\n        el.innerHTML = `\n          <div class=\"flex items-center justify-between gap-1 mb-1\">\n            <span class=\"text-xs font-bold truncate\">${z.zone_name_kr}</span>\n            <span class=\"text-[10px] px-1.5 py-0.5 rounded ${st.badge}\">${st.tag}</span>\n          </div>\n          <div class=\"flex items-baseline justify-between\">\n            <div class=\"text-xl font-extrabold tracking-tight\">SVS ${z.svs_score}</div>\n            <div class=\"text-[11px] font-mono opacity-85\">배율 x${z.tactical_multiplier}</div>\n          </div>\n          <div class=\"mt-1.5 pt-1.5 border-t border-white/10 flex justify-between text-[10px] font-mono opacity-90\">\n            <span>속도 ΔV:${z.velocity_gap >= 0 ? '+' : ''}${z.velocity_gap}</span>\n            <span>침투 ΔM:${z.movement_gap >= 0 ? '+' : ''}${z.movement_gap}</span>\n            <span>역동작 ΔA:${z.agility_gap >= 0 ? '+' : ''}${z.agility_gap}</span>\n          </div>\n        `;\n      });\n\n      // Render Matchup Cards\n      const mContainer = document.getElementById(\"matchupList\");\n      mContainer.innerHTML = matchups.map(m => {\n        const bleedBadge = m.is_bleed_point\n          ? `<span class=\"text-[10px] font-extrabold px-2 py-0.5 rounded bg-rose-500 text-slate-950\">유혈 지점 포착</span>`\n          : `<span class=\"text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-400\">정상 경합</span>`;\n\n        const borderCls = m.is_bleed_point ? \"border-rose-500/50 bg-slate-950/90\" : \"border-slate-800 bg-slate-950/50\";\n        return `\n          <div class=\"rounded-xl border ${borderCls} p-3 flex flex-col gap-2\">\n            <div class=\"flex items-center justify-between\">\n              <span class=\"text-xs font-bold text-slate-200\">${m.zone_label}</span>\n              ${bleedBadge}\n            </div>\n\n            <div class=\"grid grid-cols-2 gap-2 bg-slate-900/90 p-2 rounded-lg border border-slate-800/80 text-xs\">\n              <div>\n                <div class=\"text-emerald-400 font-bold\">${m.att.name} (${m.att.slot})</div>\n                <div class=\"text-[11px] text-slate-400\">체력 ${m.att.condition.toFixed(0)}% · 실효드리블 ${m.att.effective_attrs.dribbling}</div>\n              </div>\n              <div class=\"text-right\">\n                <div class=\"text-rose-400 font-bold\">${m.dfn.name} (${m.dfn.slot}) ${m.dfn.is_booked ? '🟨' : ''}</div>\n                <div class=\"text-[11px] text-slate-400\">\n                  체력 <span class=\"${m.dfn.condition <= 70 ? 'text-rose-400 font-bold' : 'text-slate-300'}\">${m.dfn.condition.toFixed(0)}%</span>\n                  · 실효태클 ${m.dfn.effective_attrs.tackling} <span class=\"text-[10px] text-slate-500\">(기본 ${m.dfn.base_attrs.tackling})</span>\n                </div>\n              </div>\n            </div>\n\n            <!-- 3 Probability Bars -->\n            <div class=\"space-y-1.5 text-[11px]\">\n              <div>\n                <div class=\"flex justify-between mb-0.5\">\n                  <span class=\"text-slate-300\">1:1 온더볼 돌파 성공 기대 확률 (P_dribble)</span>\n                  <span class=\"font-bold ${m.dribble_prob >= 66 ? 'text-emerald-400' : 'text-slate-200'}\">${m.dribble_prob}%</span>\n                </div>\n                <div class=\"w-full h-2 bg-slate-800 rounded-full overflow-hidden\">\n                  <div class=\"h-full ${m.dribble_prob >= 66 ? 'bg-emerald-400' : 'bg-sky-500'}\" style=\"width: ${m.dribble_prob}%\"></div>\n                </div>\n              </div>\n\n              <div class=\"grid grid-cols-2 gap-3 pt-1\">\n                <div>\n                  <div class=\"flex justify-between mb-0.5\">\n                    <span class=\"text-slate-400\">공중볼 승률 (P_aerial)</span>\n                    <span class=\"font-bold ${m.aerial_prob >= 66 ? 'text-amber-300' : 'text-slate-300'}\">${m.aerial_prob}%</span>\n                  </div>\n                  <div class=\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\">\n                    <div class=\"h-full bg-amber-400\" style=\"width: ${m.aerial_prob}%\"></div>\n                  </div>\n                </div>\n                <div>\n                  <div class=\"flex justify-between mb-0.5\">\n                    <span class=\"text-slate-400\">압박 턴오버 (P_trap)</span>\n                    <span class=\"font-bold ${m.press_trap_prob >= 68 ? 'text-rose-400' : 'text-slate-300'}\">${m.press_trap_prob}%</span>\n                  </div>\n                  <div class=\"w-full h-1.5 bg-slate-800 rounded-full overflow-hidden\">\n                    <div class=\"h-full bg-rose-500\" style=\"width: ${m.press_trap_prob}%\"></div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            ${m.bleed_reasons.length ? `\n              <div class=\"text-[11px] text-rose-300 bg-rose-950/40 border border-rose-500/30 rounded-lg px-2.5 py-1.5 space-y-0.5\">\n                ${m.bleed_reasons.map(r => `<div>• ${r}</div>`).join('')}\n              </div>\n            ` : ''}\n          </div>\n        `;\n      }).join('');\n\n      // Render Tactical Recommendations\n      document.getElementById(\"recCountBadge\").textContent = `${recs.length}건 활성`;\n      const rContainer = document.getElementById(\"recommendationList\");\n      rContainer.innerHTML = recs.map(r => {\n        const prioBadge = r.priority === \"URGENT\"\n          ? `<span class=\"text-[10px] font-extrabold px-2 py-0.5 rounded bg-amber-400 text-slate-950\">최우선 지시 (URGENT)</span>`\n          : `<span class=\"text-[10px] font-bold px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/40\">권장 지시 (HIGH)</span>`;\n\n        return `\n          <div class=\"rounded-xl border border-slate-800 bg-slate-950/80 p-3.5 flex flex-col gap-2\">\n            <div class=\"flex items-center justify-between gap-2\">\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-[11px] font-mono font-bold text-emerald-400\">[${r.rule_id}]</span>\n                <span class=\"text-[11px] text-slate-400 font-semibold\">${r.category}</span>\n              </div>\n              ${prioBadge}\n            </div>\n\n            <div class=\"text-xs font-bold text-white leading-snug\">${r.title}</div>\n\n            <div class=\"flex flex-wrap gap-1.5 my-0.5\">\n              ${r.action_badges.map(b => `\n                <span class=\"text-[11px] font-semibold px-2.5 py-1 rounded-md bg-emerald-500/15 border border-emerald-500/40 text-emerald-300\">\n                  ✓ ${b}\n                </span>\n              `).join('')}\n            </div>\n\n            <p class=\"text-[11px] text-slate-300 leading-relaxed\">${r.reasoning}</p>\n            <div class=\"text-[10px] font-mono text-slate-500 text-right\">근거 지표: ${r.trigger_metric}</div>\n          </div>\n        `;\n      }).join('');\n    }\n\n    function syncControlsFromState() {\n      const opp = currentState.opponent_team;\n      const dl = opp.players.find(p => [\"DL\", \"WBL\"].includes(p.slot)) || opp.players[0];\n      document.getElementById(\"inp_dl_cond\").value = dl.condition;\n      document.getElementById(\"inp_dl_booked\").checked = dl.is_booked;\n      document.getElementById(\"inp_def_line\").value = opp.defensive_line;\n      document.getElementById(\"inp_def_width\").value = opp.defensive_width;\n      updateControlLabels();\n    }\n\n    function updateControlLabels() {\n      const cond = +document.getElementById(\"inp_dl_cond\").value;\n      const g = computeGamma(cond);\n      document.getElementById(\"lbl_dl_cond\").textContent = `${cond}% (γ=${g.toFixed(2)})`;\n\n      const lineVal = +document.getElementById(\"inp_def_line\").value;\n      const lineNames = [\"\", \"1단계 (매우 낮음)\", \"2단계 (낮음)\", \"3단계 (표준)\", \"4단계 (높음)\", \"5단계 (매우 높음)\"];\n      document.getElementById(\"lbl_def_line\").textContent = lineNames[lineVal];\n\n      const widthVal = +document.getElementById(\"inp_def_width\").value;\n      const widthNames = [\"\", \"1단계 (극단적 중앙밀집)\", \"2단계 (중앙 밀집)\", \"3단계 (표준)\", \"4단계 (넓게)\", \"5단계 (매우 넓게)\"];\n      document.getElementById(\"lbl_def_width\").textContent = widthNames[widthVal];\n    }\n\n    function onControlChange() {\n      updateControlLabels();\n      const opp = currentState.opponent_team;\n      const dl = opp.players.find(p => [\"DL\", \"WBL\"].includes(p.slot)) || opp.players[0];\n      dl.condition = +document.getElementById(\"inp_dl_cond\").value;\n      dl.is_booked = document.getElementById(\"inp_dl_booked\").checked;\n      opp.defensive_line = +document.getElementById(\"inp_def_line\").value;\n      opp.defensive_width = +document.getElementById(\"inp_def_width\").value;\n      renderDashboard();\n    }\n\n    function selectScenario(scenId) {\n      currentState = JSON.parse(JSON.stringify(SCENARIO_PRESETS[scenId]));\n      currentState.my_team = JSON.parse(JSON.stringify(MY_TEAM_TEMPLATE));\n\n      const mapBtn = {\n        high_line_tired_fb: \"btn_scen_1\",\n        low_block_central_congestion: \"btn_scen_2\",\n        aerial_mismatch_press_trap: \"btn_scen_3\"\n      };\n      Object.entries(mapBtn).forEach(([id, btnId]) => {\n        const el = document.getElementById(btnId);\n        if (id === scenId) {\n          el.className = \"text-xs px-3 py-1.5 rounded-lg font-semibold border transition bg-emerald-500/20 border-emerald-500/50 text-emerald-300\";\n        } else {\n          el.className = \"text-xs px-3 py-1.5 rounded-lg font-semibold border transition bg-slate-900 border-slate-700 text-slate-300 hover:bg-slate-800\";\n        }\n      });\n\n      syncControlsFromState();\n      renderDashboard();\n    }\n\n    // Initialize on load\n    syncControlsFromState();\n    renderDashboard();\n  </script>\n</body>\n</html>\n","Overwrite":true,"Path":"c:\\GProjects\\FM_REA_HeadCoach\\frontend\\index.html"}}]}
